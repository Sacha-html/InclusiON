                <mxCell id="f6" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#333333;" parent="l2" source="t5" target="gw_merge" edge="1">
