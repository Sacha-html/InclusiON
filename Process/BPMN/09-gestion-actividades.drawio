                <!-- Cross-lane: user tasks → service tasks (straight down, same column) -->
                <mxCell id="f4" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#333333;" parent="pool" source="t1" target="t5" edge="1">
