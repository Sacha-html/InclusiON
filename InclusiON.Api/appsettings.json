{
  "ConnectionStrings": {
    "PostgreSqlConn": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Secret": "TuClaveSecretaMuySeguraDeAlMenos32CaracteresParaHmacSha256Algorithm",
    "Issuer": "InclusiON.Api",
    "Audience": "InclusiON.Client",
    "ExpirationHours": 1
  },
  "ApplicationSettings": {
    "Name": "InclusiON",
    "Version": "1.0.0",
    "Environment": "Base"
  },
  "SmtpSettings": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromEmail": "noreply@inclusion.app",
    "FromName": "InclusiON",
    "UseSsl": true,
    "Enabled": false
  },
  "EncryptionSettings": {
    "Key": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
  },
  "Telemetry": {
    "ServiceName": "InclusiON-API",
    "ServiceVersion": "1.0.0",
    "Enabled": true
  },
  "Cors": {
    // Sobreescribir en cada environment. Vacío = CORS bloqueado (seguro por defecto).
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    // IPs del load balancer / reverse proxy. Vacío = conexión directa (dev).
    // En producción: agregar la IP real del LB para que X-Forwarded-For sea procesado
    // y el rate limiter use el IP del cliente, no el del LB.
    "TrustedProxies": []
  },
  "PasswordResetSettings": {
    "TokenExpiryMinutes": 15
  },
  "RateLimiter": {
    "Disabled": true
  },
  "BackgroundJobs": {
    "Worker": {
      "PendingJobsIntervalSeconds": 60,
      "MidnightCleanupHour": 3,
      "BatchSize": 10,
      "OrphanTimeoutMinutes": 5
    },
    "RetryPolicies": {
      "EmbeddingMaxRetries": 3,
      "EmbeddingBaseDelaySeconds": 1,
      "EmailMaxRetries": 5,
      "EmailBaseDelaySeconds": 2,
      "DefaultMaxRetries": 3
    },
    "CircuitBreaker": {
      "FailureThreshold": 0.5,
      "MinThroughput": 10,
      "BreakDurationSeconds": 30
    },
    "PythonAgent": {
      "Url": "http://localhost:5050",
      "TimeoutSeconds": 60
    }
  }
}
